# ---- database ----
POSTGRES_USER=codelift
POSTGRES_PASSWORD=codelift
POSTGRES_DB=codelift
POSTGRES_PORT=5434
DATABASE_URL=postgresql://codelift:codelift@localhost:5434/codelift?schema=public

# Dropped and recreated by the e2e suite on every run. Must be a DIFFERENT database.
TEST_DATABASE_URL=postgresql://codelift:codelift@localhost:5434/codelift_test?schema=public

# ---- api ----
API_PORT=3334
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-32-byte-random-hex-string
JWT_EXPIRES_IN=30d
WEB_ORIGIN=http://localhost:3010
COOKIE_SECURE=false

# ---- seed user (the single personal account) ----
SEED_USER_EMAIL=me@code-lift.local
SEED_USER_PASSWORD=change-me
SEED_USER_NAME=Lucas

WEB_PORT=3010

# ---- web ----
NEXT_PUBLIC_API_URL=http://localhost:3334
