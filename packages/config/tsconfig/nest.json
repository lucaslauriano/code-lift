{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  }
}
